      "decision": "translate"
    },
    {
      "slot": "field/x:Imap/maxUidBatches/description",
      "original": "Maximum number of UID ranges returned by a single UIDBATCHES command; wider requests are rejected with a TOOMANY response code",
      "ru": "Максимальное число диапазонов UID, возвращаемых одной командой UIDBATCHES; запросы с большим числом диапазонов отклоняются с кодом ответа TOOMANY",
