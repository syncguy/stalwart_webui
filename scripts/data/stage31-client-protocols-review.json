      "decision": "translate"
    },
    {
      "slot": "field/x:Http/forwardedHops/description",
      "original": "Number of trusted proxy entries appended to the forwarding header; the client address is taken this many entries from the right.",
      "ru": "Число записей доверенных прокси-серверов, добавляемых в заголовок переадресации; адрес клиента берётся из записи на указанной позиции справа.",
      "decision": "translate"
    },
